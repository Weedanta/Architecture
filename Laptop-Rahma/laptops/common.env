# Group-wide settings, identical on all four laptops (safe to commit).
# Group name, used in the MQTT topic so we do not mix with other groups on the shared broker
GROUP=kelompok-jnrw
# Replace with Wedanta's (collector) IP. Use SHOW_MY_IP.bat on Wedanta's laptop, or run 2_SET_COLLECTOR_IP.bat.
COLLECTOR_IP=192.168.1.10
REST_PORT=5151
# Block C across networks: ngrok URL (ngrok http 5151), e.g. https://xxxx.ngrok-free.app
REST_PUBLIC_URL=
# Run settings (can be overridden with --interval/--duration in play.py)
INTERVAL=1.0
DURATION=60
GAP=5
POLL_INTERVAL=0.2
